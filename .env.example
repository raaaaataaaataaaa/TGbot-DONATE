# Токен бота, полученный у @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Webhook / callback URL (должен быть доступен из интернета по HTTPS)
WEBHOOK_BASE_URL=https://your-domain.com

# Порт для приёма вебхуков платежей
WEBHOOK_PORT=8081

# ID Telegram-пользователей, которые являются администраторами (через запятую)
ADMIN_IDS=100000001,100000002

# Секретная фраза для входа в админ-панель через /adminpanel
ADMIN_PANEL_SECRET=change-me-please

# --- RollyPay (https://rollypay.io) ---
ROLLYPAY_API_KEY=
ROLLYPAY_PROJECT_ID=

# --- CryptoBot (@CryptoBot / https://cryptobot.app API) ---
CRYPTOBOT_API_TOKEN=

# --- Platega (https://platega.io) ---
PLATEGA_MERCHANT_ID=
PLATEGA_API_KEY=
PLATEGA_CALLBACK_SECRET=

# --- Прочие настройки ---
DATABASE_URL=sqlite+aiosqlite:///./donate.db
CURRENCY=RUB
DONATE_MIN_AMOUNT=50
DONATE_MAX_AMOUNT=100000
CHANNEL_ID=
